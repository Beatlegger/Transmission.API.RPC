<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>

        <!-- NuGet package metadata -->
        <PackageId>Transmission.API.RPC</PackageId>
        <Version>4.0.0</Version>
        <Authors>Beatlegger, FatihBAKIR, Andreschort, svonidze</Authors>
        <Company>Beatlegger</Company>
        <Description>Async client for Transmission BitTorrent RPC API. Targets .NET 10.</Description>
        <PackageTags>Transmission;RPC;BitTorrent;Torrent</PackageTags>
        <Copyright>Copyright © 2026</Copyright>

        <RepositoryUrl>https://github.com/Beatlegger/Transmission.API.RPC</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageProjectUrl>https://github.com/Beatlegger/Transmission.API.RPC</PackageProjectUrl>
        <PackageReadmeFile>README.nuget.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>

        <!-- Build quality -->
        <IsAotCompatible>true</IsAotCompatible>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>

        <!-- Source Link -->
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <Deterministic>true</Deterministic>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.nuget.md" Pack="true" PackagePath="\" />
        <None Include="icon.png" Pack="true" PackagePath="\" />
    </ItemGroup>


</Project>
